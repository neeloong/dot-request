{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "target": "esnext",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "strictNullChecks": true,
    "declaration": true,
    // "emitDeclarationOnly": true,
    "noImplicitThis": true,
    "moduleResolution": "Node"
  },
  "include": ["src/**/*"]
}
