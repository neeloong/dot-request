{
  "compilerOptions": {
    "lib": ["ESNext", "ES2025", "DOM"],
    "allowJs": true,
    "checkJs": true,
    "target": "esnext",
    "rootDir": "./src",
    "outDir": "./types",
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "strictNullChecks": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "noImplicitThis": true,
    "moduleResolution": "Bundler",
  },
  "include": ["src/**/*"]
}
